# cAdvisor - generated by Ansible.
# network_mode: host so the central Prometheus can scrape it over the private LAN.
#
# NOTE: `privileged: true` is required for reliable cgroup (v2) access across
# kernels. cAdvisor is bound to 0.0.0.0 over the private LAN only - restrict
# with a host firewall if needed. All host mounts are read-only.
# Distinct project name so --remove-orphans never touches alloy/node_exporter.

name: monitoring-agent-cadvisor

services:
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    network_mode: host
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    command:
      - --housekeeping_interval=30s
      - --port={{ cadvisor_port }}
      - --docker_only
