// Grafana Alloy configuration - generated by Ansible.
// Discovers Docker containers via the host socket and ships stdout/stderr
// logs to Loki on the central Grafana server.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "host_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.docker.containers.targets

  // Static + derived labels. Container IDs are intentionally NOT used as
  // labels to keep Loki label cardinality low.
  relabel_rules {
    rule {
      action       = "replace"
      target_label = "host"
      replacement  = "{{ inventory_hostname }}"
    }
    rule {
      action       = "replace"
      target_label = "environment"
      replacement  = "{{ monitoring_environment }}"
    }
    rule {
      action        = "replace"
      source_labels = ["__meta_docker_container_name"]
      target_label  = "container_name"
      regex         = "(.+)"
      replacement   = "$1"
    }
    // Only set `service` for containers created by Docker Compose.
    rule {
      action        = "replace"
      source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
      target_label  = "service"
      regex         = "(.+)"
      replacement   = "$1"
    }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "{{ loki_push_url }}"
  }
}
