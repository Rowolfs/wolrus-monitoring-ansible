# Grafana Alloy agent - generated by Ansible.
# network_mode: host + loopback bind keeps Alloy's own UI private while still
# allowing outbound log pushes to the central Loki.
# Distinct project name so --remove-orphans never touches node_exporter/cadvisor.

name: monitoring-agent-alloy

services:
  alloy:
    image: {{ alloy_image }}
    container_name: alloy
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - alloy-data:/var/lib/alloy
    command:
      - run
      - --server.http.listen-addr=127.0.0.1:{{ alloy_listen_port }}
      - --storage.path=/var/lib/alloy
      - /etc/alloy/config.alloy

volumes:
  alloy-data:
