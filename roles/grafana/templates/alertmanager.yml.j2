# Alertmanager configuration - generated by Ansible.
# Uses Alertmanager native telegram_configs receiver. Resolved notifications enabled.

global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  group_by: ["alertname", "host"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: telegram

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: {{ telegram_chat_id }}
        send_resolved: true
        # Telegram message uses the Go template in templates/telegram.tmpl.
        # {% raw %} is used so Jinja2 does not interpret Go templating.
        message: '{% raw %}{{ template "telegram.default" . }}{% endraw %}'
