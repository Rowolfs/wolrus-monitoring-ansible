# Prometheus configuration - generated by Ansible.
# Scrape targets are derived from the `nodes` inventory group (single source of truth).

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: "{{ monitoring_environment }}"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
          - "localhost:9090"
        labels:
          environment: "{{ monitoring_environment }}"

  - job_name: "node_exporter"
    static_configs:
{% for host in groups['nodes'] %}
      - targets:
          - "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ node_exporter_port }}"
        labels:
          host: "{{ host }}"
          environment: "{{ monitoring_environment }}"
{% endfor %}

  - job_name: "cadvisor"
    static_configs:
{% for host in groups['nodes'] %}
      - targets:
          - "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ cadvisor_port }}"
        labels:
          host: "{{ host }}"
          environment: "{{ monitoring_environment }}"
{% endfor %}
