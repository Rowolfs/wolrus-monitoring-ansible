# node_exporter - generated by Ansible.
# network_mode: host so Prometheus on the central server can scrape it over the
# private LAN. Restrict with a host firewall if the LAN is not fully trusted.
# Distinct project name so --remove-orphans never touches alloy/cadvisor.

name: monitoring-agent-node-exporter

services:
  node_exporter:
    image: {{ node_exporter_image }}
    container_name: node_exporter
    restart: unless-stopped
    pid: host
    network_mode: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro,rslave
    command:
      - --web.listen-address=:{{ node_exporter_port }}
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --path.rootfs=/host/root
      - --collector.filesystem.ignored-mount-points=^/(sys|proc|dev|host|etc)($|/)
      - --collector.filesystem.ignored-fs-types=^(tmp|autofs|binfmt|configfs|bpf|fuse\.ctl|cgroup|pstore|securityfs|nsfs|mqueue)($|.*)
